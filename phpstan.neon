includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/mspirkov/yii2-phpstan/extension.neon

parameters:
    level: 8

    paths:
        - src
        - tests

    excludePaths:
        - tests/stubs/Yii.php

    bootstrapFiles:
        - vendor/yiisoft/yii2/Yii.php

    mspirkovYii2:
        enableAllRules: false
        enableValidationRules: true
        yiiAppTypes:
            -
                paths:
                    - tests/functional
                type: yii\console\Application
                nullable: false

    # TODO: remove after updating Yii2 to 2.0.56.
    ignoreErrors:
        -
            message: '#^Parameter \#3 \$type of method yii\\db\\Command::(addColumn|alterColumn)\(\) expects string, yii\\db\\ColumnSchemaBuilder given\.$#'
            identifier: argument.type
        -
            message: '#^Object option "(request|response)" for bizley\\migration\\controllers\\(Base)?MigrationController must be yii\\console\\(Request|Response), string given\.$#'
            identifier: mspirkovYii2.baseObjectInstantiationValidation
        -
            message: '#^Cannot access property \$driverName on array\|string\|yii\\db\\Connection\.$#'
            identifier: property.nonObject
        -
            message: '#^Object option "(precision|scale)" for yii\\db\\ColumnSchema must be int, null given\.$#'
            identifier: mspirkovYii2.baseObjectInstantiationValidation
        # Yii documents $unique as bool only, but PostgreSQL QueryBuilder accepts the index method there as well.
        -
            message: '#^Parameter \#4 \$unique of method yii\\db\\Migration::createIndex\(\) expects bool, string given\.$#'
            identifier: argument.type
            path: tests/migrations/m20200406_124200_create_table_updater_base.php
